{
  "name": "dsh-thread",
  "version": "0.2.0-rc.6",
  "description": "Explicit cross-session Thread handoffs for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./tool": {
      "default": "./lib/tool.js"
    },
    "./gateway": {
      "default": "./lib/gateway.js"
    },
    "./draft": {
      "default": "./lib/draft.js"
    },
    "./identity": {
      "default": "./lib/identity.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    },
    "desktop": {
      "ship": true,
      "tarball": "thread.tar.gz",
      "dest": "plugins/dsh-thread",
      "env": "DSH_DESKTOP_THREAD_PLUGIN",
      "pin": "0.2.0-rc.6"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "files": [
    "lib/index.js",
    "lib/gateway.js",
    "lib/tool.js",
    "lib/draft.js",
    "lib/identity.js",
    "lib/thread-types.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "session",
    "handoff"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-session-title": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/schemastery": ">=3.18.1 <4",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@crazx/dsh-agent-default-model": "0.1.2-alpha.5.zw.1",
    "@crazx/dsh-session-persistence": "0.1.2-alpha.5.zw.1",
