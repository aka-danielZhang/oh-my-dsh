    "@deepseek-ai/dsh-util-workspace-path": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-workspace": "0.1.2-alpha.5",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
