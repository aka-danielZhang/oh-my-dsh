{
  "name": "dsh-copy-session-id",
  "version": "0.1.0",
  "description": "DSH web plugin: takes over the session-header ellipsis menu with a Copy Session ID item beside the stock Download Session Log entry (and re-hosts the download status dialog)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "desktop": {
      "ship": true,
      "tarball": "copy-session-id.tar.gz",
      "dest": "plugins/dsh-copy-session-id",
      "env": "DSH_DESKTOP_COPY_SESSION_ID_PLUGIN",
      "pin": "0.1.0"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "plugin:add": "dsh plugin --profile web add file:.",
    "plugin:remove": "dsh plugin --profile web remove dsh-copy-session-id"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aka-danielZhang/oh-my-dsh.git",
    "directory": "plugin/dsh-copy-session-id"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-alpha.1 <1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.4",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "npm:@crazx/dsh-client-ui-conversation@0.1.5-rc.2.zw.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.7.0"
}
