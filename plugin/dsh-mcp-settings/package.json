{
  "name": "dsh-mcp-settings",
  "version": "0.2.6",
  "description": "Settings-driven MCP server manager, inventory Remote, and Web settings UI for DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm run bundle",
    "bundle": "tsdown",
    "dev:web": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "prepare": "tsdown",
    "smoke": "node --check lib/index.js && node --check lib/manager.js && node --check lib/manager-types.js && node --check lib/inventory.js && node --check lib/inventory-types.js && node --check lib/typert.host.js && node --check lib/typert.remote-client.js && node --check lib/client.js",
    "plugin:add": "dsh plugin --profile web add file:.",
    "plugin:remove": "dsh plugin --profile web remove dsh-mcp-settings",
    "plugin:dump": "dsh --profile web --dump-config"
  },
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./manager": {
      "types": "./src/manager.ts",
      "default": "./lib/manager.js"
    },
    "./manager-types": {
      "types": "./src/manager-types.ts",
      "default": "./lib/manager-types.js"
    },
    "./inventory": {
      "types": "./src/inventory.ts",
      "default": "./lib/inventory.js"
    },
    "./inventory-types": {
      "types": "./src/inventory-types.ts",
      "default": "./lib/inventory-types.js"
    },
    "./invariant": {
      "types": "./src/invariant.ts",
      "default": "./lib/invariant.js"
    },
    "./typert": {
      "types": "./src/typert.host.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./src/typert.remote-client.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aka-danielZhang/oh-my-dsh.git",
    "directory": "plugin/dsh-mcp-settings"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-credentials": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-invariants": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-settings": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-timeout": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-alpha.1 <1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.5-rc.1",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.1",
    "@deepseek-ai/dsh-http-proxy": "0.1.5-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.5-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.1",
    "@deepseek-ai/dsh-mcp-client": "npm:@crazx/dsh-mcp-client@0.1.5-rc.1.zw.1",
    "@deepseek-ai/dsh-scope": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.5-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@shikijs/langs": "^4.3.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "immer": "^10.1.1",
    "jsdom": "^29.1.1",
    "katex": "^0.16.47",
    "lightningcss": "^1.30.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "^4.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.8",
    "zod": "4.4.3",
    "zustand": "~4.4.7"
  },
  "dsh": {
    "desktop": {
      "ship": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  }
}
