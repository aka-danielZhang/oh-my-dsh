{
  "name": "dsh-mcp-settings",
  "version": "0.2.5",
  "description": "Settings-driven MCP server manager, inventory Remote, and Web settings UI for DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm run bundle",
    "bundle": "tsdown",
    "dev:web": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "prepare": "tsdown",
    "smoke": "node --check lib/index.js && node --check lib/manager.js && node --check lib/manager-types.js && node --check lib/inventory.js && node --check lib/inventory-types.js && node --check lib/typert.host.js && node --check lib/typert.remote-client.js && node --check lib/client.js",
    "plugin:add": "dsh plugin --profile web add file:.",
    "plugin:remove": "dsh plugin --profile web remove dsh-mcp-settings",
    "plugin:dump": "dsh --profile web --dump-config"
  },
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./manager": {
      "types": "./src/manager.ts",
      "default": "./lib/manager.js"
    },
    "./manager-types": {
      "types": "./src/manager-types.ts",
      "default": "./lib/manager-types.js"
    },
    "./inventory": {
      "types": "./src/inventory.ts",
      "default": "./lib/inventory.js"
    },
    "./inventory-types": {
      "types": "./src/inventory-types.ts",
      "default": "./lib/inventory-types.js"
    },
    "./invariant": {
      "types": "./src/invariant.ts",
      "default": "./lib/invariant.js"
    },
    "./typert": {
      "types": "./src/typert.host.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./src/typert.remote-client.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/manager.js",
    "lib/manager-types.js",
    "lib/inventory.js",
    "lib/inventory-types.js",
    "lib/typert.host.js",
    "lib/typert.remote-client.js",
    "lib/client.js",
    "lib/client.js.map",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aka-danielZhang/oh-my-dsh.git",
    "directory": "plugin/dsh-mcp-settings"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-mcp-client": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-timeout": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.0.1-rc.1 <1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-mcp-client": "npm:@crazx/dsh-mcp-client@0.1.2-alpha.3.zw.2",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subprocess": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-timeout": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.5",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.30.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  }
}
