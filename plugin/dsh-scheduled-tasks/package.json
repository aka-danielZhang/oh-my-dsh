{
  "name": "dsh-scheduled-tasks",
  "version": "0.1.0",
  "description": "设置·定时任务：全局每日 Agent 任务与系统任务目录",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./ohmymemo": {
      "default": "./lib/ohmymemo.js"
    },
    "./api": {
      "default": "./lib/api.js"
    },
    "./types": {
      "default": "./lib/types.js"
    },
    "./schedule": {
      "default": "./lib/schedule.js"
    },
    "./lease": {
      "default": "./lib/lease.js"
    },
    "./remote": {
      "default": "./lib/typert.remote-client.js"
    },
    "./typert.host": {
      "default": "./lib/typert.host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "plugin:add": "dsh plugin --profile web add file:.",
    "plugin:remove": "dsh plugin --profile web remove dsh-scheduled-tasks"
  },
  "files": [
    "lib/*.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aka-danielZhang/oh-my-dsh.git",
    "directory": "plugin/dsh-scheduled-tasks"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-agent-default-model": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-brand": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-jobs": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-llm": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-permission-presets": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-session": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-session-query": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-session-title": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-storage": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-workspace": ">=0.1.5-alpha.1 <1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.4",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.1",
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.1",
