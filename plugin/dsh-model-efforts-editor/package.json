{
  "name": "dsh-model-efforts-editor",
  "version": "0.1.1",
  "description": "Edit per-model reasoning efforts (and dispatch compat) inline in the stock Models settings card - the GUI field llm-pi-ai exposes but stock settings never edits",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    },
    "desktop": {
      "ship": true,
      "tarball": "model-efforts-editor.tar.gz",
      "dest": "plugins/dsh-model-efforts-editor",
      "env": "DSH_DESKTOP_MODEL_EFFORTS_EDITOR_PLUGIN",
      "pin": "0.1.1"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "plugin:add": "dsh plugin --profile web add file:.",
    "plugin:remove": "dsh plugin --profile web remove dsh-model-efforts-editor"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aka-danielZhang/oh-my-dsh.git",
    "directory": "plugin/dsh-model-efforts-editor"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc.1 <1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.5",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
