{
  "name": "dsh-usage-stats",
  "version": "0.1.3",
  "description": "\u8bbe\u7f6e\u00b7\u4f7f\u7528\u7edf\u8ba1\uff1aToken \u7528\u91cf\u3001\u6d3b\u52a8\u70ed\u529b\u56fe\u3001Provider/\u6a21\u578b\u5206\u5e03\u4e0e\u6bcf\u65e5\u8d8b\u52bf",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./collector": {
      "default": "./lib/collector.js"
    },
    "./gateway": {
      "default": "./lib/gateway.js"
    },
    "./types": {
      "default": "./lib/types.js"
    },
    "./remote": {
      "default": "./lib/typert.remote-client.js"
    },
    "./typert.host": {
      "default": "./lib/typert.host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "desktop": {
      "ship": true,
      "tarball": "usage-stats.tar.gz",
      "dest": "plugins/dsh-usage-stats"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "node --import tsx --test tests/*.test.ts && vitest run",
    "plugin:add": "dsh plugin --profile web add file:.",
    "plugin:remove": "dsh plugin --profile web remove dsh-usage-stats"
  },
  "files": [
    "lib/*.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "usage-stats",
    "settings"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aka-danielZhang/oh-my-dsh.git",
    "directory": "plugin/dsh-usage-stats"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.5-alpha.1 <1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-alpha.1 <1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.5-rc.2",
    "@shikijs/langs": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "immer": "^10.1.1",
    "jsdom": "^29.1.1",
    "katex": "^0.16.47",
    "lightningcss": "^1.30.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "playwright-core": "^1.63.0",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "shiki": "^4.3.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "4.4.3",
    "zustand": "~4.4.7"
  },
  "packageManager": "pnpm@11.7.0"
}
