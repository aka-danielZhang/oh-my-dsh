{
  "name": "dsh-ohmymemo",
  "version": "0.1.0",
  "description": "OhMyMemo persistent Markdown memory for DSH with explicit tools, context capsules, scheduled evidence-grounded candidate extraction, and a read-only Memory settings UI",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./tools": {
      "default": "./lib/tools.js"
    },
    "./context": {
      "default": "./lib/context.js"
    },
    "./manager": {
      "default": "./lib/manager.js"
    },
    "./api": {
      "default": "./lib/api.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "desktop": {
      "ship": true,
      "pin": "0.1.0"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "plugin:add": "dsh plugin --profile web add file:.",
    "plugin:remove": "dsh plugin --profile web remove dsh-ohmymemo"
  },
  "files": [
    "lib/*.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "markdown-store"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aka-danielZhang/oh-my-dsh.git",
    "directory": "plugin/dsh-ohmymemo"
  },
  "devDependencies": {
    "@crazx/dsh-agent-default-model": "0.1.2-alpha.3.zw.2",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-timer": "1.1.4",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-jobs": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-query": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-storage-domain": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-registry": "0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.28.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5",
    "@deepseek-ai/cordis-plugin-timer": ">=1.1.4 <2",
    "@deepseek-ai/dsh-agent": ">=0.1.2-alpha.3 <1",
    "@crazx/dsh-agent-default-model": ">=0.1.2-alpha.3.zw.2 <1",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-client-store": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-jobs": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-llm": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-session": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-session-query": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-tools": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.2-alpha.3 <1",
    "@deepseek-ai/schemastery": ">=3.18.1 <4",
    "react": "^18.2.0"
  }
}
