{
  "name": "dsh-ohmymemo",
  "version": "0.1.0",
  "description": "OhMyMemo: persistent user memory for DSH — Phase 1 Markdown store medium contract plus Phase 2 explicit memory loop (ctx.ohMyMemo service, five memory_* tools, bounded views, pre-step context capsule)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./tools": {
      "default": "./lib/tools.js"
    },
    "./context": {
      "default": "./lib/context.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "plugin:add": "dsh plugin --profile web add file:.",
    "plugin:remove": "dsh plugin --profile web remove dsh-ohmymemo"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "markdown-store"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aka-danielZhang/oh-my-dsh.git",
    "directory": "plugin/dsh-ohmymemo"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.3",
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <1"
  }
}
