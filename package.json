{
  "name": "oh-my-dsh",
  "version": "0.3.0-rc.31",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "desktop:dev": "node scripts/launch-electron.mjs",
    "desktop:electron": "node scripts/launch-electron.mjs",
    "desktop:prepare": "node scripts/prepare-desktop-bundle.mjs",
    "desktop:build": "pnpm run desktop:prepare && node scripts/build-electron.mjs",
    "desktop:build:signed": "pnpm run desktop:build",
    "desktop:test": "node --import tsx --test src/*.test.ts",
    "desktop:typecheck": "tsc --noEmit -p src/tsconfig.json",
    "desktop:smoke": "node scripts/smoke-packaged-profile.mjs",
    "plugin:setup": "node scripts/setup-plugins.mjs",
    "plugin:new": "node scripts/new-plugin.mjs",
    "plugin:check": "cd plugin/dsh-desktop-bridge && pnpm run typecheck && pnpm run test && pnpm run build",
    "plugins:check": "for d in plugin/*/; do d=${d%/}; [ -L \"$d\" ] && continue; echo \"== $d\"; (cd \"$d\" && pnpm run --if-present typecheck && pnpm run --if-present test && pnpm run --if-present build) || exit 1; done",
    "check": "pnpm run plugin:check && pnpm run desktop:typecheck && pnpm run desktop:test",
    "link:source": "node scripts/source-deps.mjs link",
    "unlink:source": "node scripts/source-deps.mjs unlink"
  },
  "dependencies": {
    "electron-updater": "^6.6.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@types/node": "^24.3.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.8",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  }
}
